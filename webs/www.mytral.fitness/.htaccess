# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN
<IfModule Litespeed>
SetEnv MYTRAL_DATA_DIR /home/ymvsiqbaay/app
</IfModule>
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION END
Options -Indexes

# always revalidate HTML so FTP updates show up without a hard reload
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# friendly branded page for not-found URLs
ErrorDocument 404 /404.html

# clean URLs + default favicon handling
<IfModule mod_rewrite.c>
    RewriteEngine On

    # point default /favicon.ico requests at the site logo
    RewriteRule ^favicon\.ico$ /mytral-logo.png [L,R=301]

    # serve foo.html for /foo when that file exists (e.g. /docs/licenses)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# hard-block vulnerability-scanner bait: this site serves no PHP and no dotfiles
<FilesMatch "\.(php|env)">
    Require all denied
</FilesMatch>
RedirectMatch 404 (?i)/(wp-login|wp-admin|wp-content|wp-includes|xmlrpc|administrator|phpinfo)

# serve the Chrome private-prefetch-proxy advice with its required content type
<Files "traffic-advice">
    ForceType application/trafficadvice+json
</Files>
