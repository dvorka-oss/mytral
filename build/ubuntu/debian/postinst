#!/bin/sh
set -e

# MyTraL requires Python 3.12, which most Ubuntu releases do not ship as the
# system interpreter. Instead of depending on the system Python, uv is used to
# provision a self-contained Python 3.12 under /opt/mytral so that MyTraL runs
# identically on every release.

PREFIX=/opt/mytral
VENV=${PREFIX}/venv
UV=${PREFIX}/bin/uv
WHEEL=$(find "${PREFIX}" -name "mytral-*.whl" | head -1)
if [ -z "${WHEEL}" ] || [ ! -f "${WHEEL}" ]; then
    echo "mytral: bundled wheel not found under ${PREFIX}" >&2
    exit 1
fi
REQUIREMENTS=${PREFIX}/requirements.txt
if [ ! -f "${REQUIREMENTS}" ]; then
    echo "mytral: requirements.txt not found at ${REQUIREMENTS}" >&2
    exit 1
fi

# pinned uv release and its published sha256 checksums, one per supported arch
UV_VERSION=0.7.8
UV_SHA256_AMD64=285981409c746508c1fd125f66a1ea654e487bf1e4d9f45371a062338f788adb
UV_SHA256_ARM64=da9e1c97f1452b25c8955127c92da7b68be228ad0b43bf50bba4dadb25c8b337

case "$1" in
    configure)
        # map dpkg architecture to the uv release triple
        case "$(dpkg --print-architecture)" in
            amd64) UV_ARCH=x86_64-unknown-linux-gnu; UV_SHA256=${UV_SHA256_AMD64} ;;
            arm64) UV_ARCH=aarch64-unknown-linux-gnu; UV_SHA256=${UV_SHA256_ARM64} ;;
            *)
                echo "mytral: unsupported architecture $(dpkg --print-architecture)" >&2
                exit 1
                ;;
        esac

        echo "mytral: downloading uv ${UV_VERSION}..."
        mkdir -p "${PREFIX}/bin"
        UV_ARCHIVE=$(mktemp)
        trap 'rm -f "${UV_ARCHIVE}"' EXIT
        curl -LsSf -o "${UV_ARCHIVE}" \
            "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${UV_ARCH}.tar.gz"

        echo "${UV_SHA256}  ${UV_ARCHIVE}" | sha256sum -c - >/dev/null || {
            echo "mytral: uv archive checksum mismatch, aborting install" >&2
            exit 1
        }

        tar -xz -C "${PREFIX}/bin" --strip-components=1 -f "${UV_ARCHIVE}" "uv-${UV_ARCH}/uv"
        rm -f "${UV_ARCHIVE}"
        trap - EXIT

        # keep the managed Python and uv cache self-contained under /opt/mytral
        export UV_PYTHON_INSTALL_DIR="${PREFIX}/python"
        export UV_CACHE_DIR="${PREFIX}/.cache"

        echo "mytral: provisioning Python 3.12 (this may take a minute)..."
        "${UV}" venv --python 3.12 "${VENV}"

        echo "mytral: installing dependencies..."
        "${UV}" pip install --python "${VENV}/bin/python" \
            -r "${REQUIREMENTS}" "${WHEEL}"

        # cache is only needed during installation
        rm -rf "${UV_CACHE_DIR}"
        ;;
esac

#DEBHELPER#

exit 0
